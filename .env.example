# ─── Database (Postgres) ──────────────────────────────────────────────────────
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ai_voice
DB_PORT=5432

# Full SQLAlchemy URL (overrides individual fields above when set)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_voice

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Email (Gmail SMTP for verification / notifications) ─────────────────────
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password

# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ─── Vapi ─────────────────────────────────────────────────────────────────────
VAPI_API_KEY=your-vapi-api-key
VAPI_PHONE_NUMBER_ID=your-phone-number-id
# Must match the secret Vapi sends: X-Vapi-Secret (serverUrlSecret), or Bearer token, or HMAC key.
# Leave empty locally to skip webhook auth (not for production).
VAPI_WEBHOOK_SECRET=your-webhook-secret

# ─── Twilio (for call transfer) ───────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
HUMAN_TRANSFER_NUMBER=+1XXXXXXXXXX

# ─── SMTP (password reset emails, optional) ───────────────────────────────────
# If SMTP is unset, development mode logs the reset URL in the uvicorn terminal.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
# PASSWORD_RESET_TOKEN_HOURS=1

# ─── App URLs ─────────────────────────────────────────────────────────────────
# Must be publicly accessible for Vapi to reach your webhook
BACKEND_URL=https://your-domain.com
FRONTEND_URL=http://localhost:5173
ENVIRONMENT=development
